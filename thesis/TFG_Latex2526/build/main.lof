\contentsline {figure}{\numberline {A.7}{\ignorespaces Module~1: interactive global RCA and LCA three-dimensional renderings with metric colormaps.}}{43}{figure.Alph1.7}%
\contentsline {figure}{\numberline {A.8}{\ignorespaces Module~2: patient clinical summary with automated CAD-RADS~2.0 category, SIS, and territory rationale.}}{44}{figure.Alph1.8}%
