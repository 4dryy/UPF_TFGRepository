\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Anterior view of the human coronary tree; right coronary artery (RCA) and left coronary artery (LCA) are highlighted in red, with other cardiac structures in blue. Adapted from Lynch et al.~\cite {lynch2010_coronary}.}}{1}{figure.1.1}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Coronary arteries narrowed by atherosclerotic plaque in coronary artery disease (CAD). Adapted from Kaiser Permanente~\cite {kaiser_atherosclerosis}.}}{2}{figure.1.2}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Current CAD diagnostic workflow at Hospital de Sant Pau, spanning coronary computed tomography angiography (CCTA) acquisition, picture archiving and communication system (PACS) storage, and radiology information system (RIS) reporting. The primary operational bottleneck (image assessment and reporting) is highlighted in red. Adapted from Ferrer Beltran~\cite {ferrer2024}.}}{4}{figure.1.3}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Detailed representation of the CCTA image analysis and reporting workflow at Hospital de Sant Pau. Adapted from Acebes Pinilla~\cite {acebes2024}.}}{5}{figure.1.4}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Contextual overview of the proposed automated CAD diagnostic framework at Hospital de la Santa Creu i Sant Pau, integrating CCTA-based analysis and Coronary Artery Disease Reporting and Data System (CAD-RADS~2.0) scoring. The contributions of this thesis (green dashed box) bridge the gap between existing hospital data systems (blue) and the final clinical report. Adapted from Acebes Pinilla~\cite {acebes2024}.}}{7}{figure.1.5}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces End-to-end per-patient workflow: lumen mask, percentage area stenosis (\%AS), and CAD-RADS~2.0 reporting. Green boxes denote workflow blocks; blue boxes denote input data; arrows show sequential data flow.}}{8}{figure.2.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Block~1 hybrid workflow: separation of right coronary artery (RCA) and left coronary artery (LCA) trees; automated per-tree seed placement; centerline geometry extraction; branch packaging.}}{10}{figure.2.2}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Block~2 workflow: orthogonal cross-sectional area extraction on each artery centerline and surface mesh, tabular integration, proximal/distal reference estimation, and \%AS quantification.}}{12}{figure.2.3}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Block~3 workflow: segment aggregation based on the SCCT-18 coronary model and automated CAD-RADS~2.0 scoring.}}{15}{figure.2.4}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Block~4 user interface layout and interaction flow: from global RCA and LCA anatomy with \%AS colormaps, through CAD-RADS~2.0 and segment involvement score (SIS) summary, to segment-level and branch-level metric validation.}}{18}{figure.2.5}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Block~1 outputs for Normal\_8 in four side-by-side panels. Left pair (ASOCA [Automated Segmentation of Coronary Arteries], then MACS-18 [Multiclass Anatomical Coronary Segmentation]): centerline paths with red ostium points and blue branch endpoints. Right pair (ASOCA, then MACS-18): smoothed lumen surfaces with light-red LCA and light-blue RCA.}}{23}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Extracted centerlines on the synthetic validation models. Left: \texttt {synthetic\_1} (healthy, uniform radius). Right: \texttt {synthetic\_2} (diseased, mid-vessel stenosis).}}{24}{figure.3.2}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Area overestimation near a coronary bifurcation. The 3D model maps \%AS (green colormap); the inset marks the maximum stenosis point (purple diamond) and automatic proximal/distal references (green circles). Bar plots show cross-sectional area (blue) and \%AS (orange), including the artificial spike after the bifurcation.}}{28}{figure.4.1}%
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {A.1}{\ignorespaces Per-patient distribution of detected endpoints for ASOCA and MACS-18 cohorts. Extends the summary statistics in \Cref {tab:endpoint-summary}.}}{40}{figure.Alph1.1}%
\contentsline {figure}{\numberline {A.2}{\ignorespaces Grouped comparison of OISR and CESR between ASOCA and MACS-18. Visual counterpart to \Cref {tab:ostium-centerline-comparison}.}}{40}{figure.Alph1.2}%
\contentsline {figure}{\numberline {A.3}{\ignorespaces Longitudinal area and \%AS profiles along \texttt {synthetic\_1}.}}{41}{figure.Alph1.3}%
\contentsline {figure}{\numberline {A.4}{\ignorespaces Longitudinal area and \%AS profiles along \texttt {synthetic\_2}.}}{41}{figure.Alph1.4}%
\contentsline {figure}{\numberline {A.5}{\ignorespaces Three-dimensional area and \%AS colormaps for \texttt {synthetic\_1}.}}{42}{figure.Alph1.5}%
\contentsline {figure}{\numberline {A.6}{\ignorespaces Three-dimensional area and \%AS colormaps for \texttt {synthetic\_2}.}}{42}{figure.Alph1.6}%
\contentsline {figure}{\numberline {A.7}{\ignorespaces Block~4 landing view showing the dashboard title, a brief description of the tool, and the patient identifier currently under review.}}{43}{figure.Alph1.7}%
\contentsline {figure}{\numberline {A.8}{\ignorespaces Module~1: interactive global RCA and LCA three-dimensional renderings with metric colormaps.}}{43}{figure.Alph1.8}%
\contentsline {figure}{\numberline {A.9}{\ignorespaces Modules~2 and~3 (initial view). Module~2 reports the automated patient clinical summary, including the CAD-RADS~2.0 category, segment involvement score (SIS), and territory rationale. Module~3 adds the selected segment label, artery-level context, and interactive segment-selection buttons; the three-dimensional artery view is colored by SCCT-18 segment, with each segment color matching its corresponding button. A table summarizes key segment metrics: maximum \%AS, area at the peak stenosis, proximal and distal reference areas, and the reference half-window $W$ used for quantification.}}{44}{figure.Alph1.9}%
\contentsline {figure}{\numberline {A.10}{\ignorespaces Module~3: segment-level three-dimensional anatomy with synchronized longitudinal profiles. The artery is rendered with a \%AS colormap and annotated in three dimensions with indicator points for the maximum stenosis location within the selected segment and for the proximal and distal reference points. The blue bar plot shows cross-sectional area and the orange bar plot shows \%AS along the selected segment; peak stenosis and reference markers are also marked in the profiles. A color legend identifies each visualization component.}}{44}{figure.Alph1.10}%
\contentsline {figure}{\numberline {A.11}{\ignorespaces Module~4: reference half-window $W$ and interactive controls to select the artery and branch under review, together with branch-level three-dimensional path highlighting and longitudinal metric profiles. A color legend identifies each visualization component.}}{45}{figure.Alph1.11}%
\contentsline {figure}{\numberline {A.12}{\ignorespaces Module~4 (continued): full-branch area and \%AS profiles displayed in proximal-to-distal order, with a summary of branch-level metrics (maximum \%AS, area at the peak stenosis, and proximal and distal reference areas).}}{45}{figure.Alph1.12}%
\addvspace {10\p@ }
