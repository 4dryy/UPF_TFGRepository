\contentsline {figure}{\numberline {1.1}{\ignorespaces Anterior view of the human coronary tree. Coronary arteries are highlighted in red, and other cardiac structures in blue. Adapted from Lynch et al.~\cite {lynch2010_coronary}.}}{1}{figure.1.1}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Coronary arteries narrowed by atherosclerotic plaque. Adapted from Kaiser Permanente~\cite {kaiser_atherosclerosis}.}}{2}{figure.1.2}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Current CAD diagnostic workflow at Hospital de Sant Pau. The primary operational bottleneck (image assessment and reporting) is highlighted in red. Adapted from Ferrer Beltran~\cite {ferrer2024}.}}{4}{figure.1.3}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Detailed representation of the image analysis and reporting workflow at Hospital de Sant Pau. Adapted from Acebes Pinilla~\cite {acebes2024}.}}{5}{figure.1.4}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Contextual overview of the proposed automated diagnostic framework at Hospital de la Santa Creu i Sant Pau. The contributions of this thesis (green dashed box) bridge the gap between existing hospital data systems (blue) and the final clinical report. Adapted from Acebes Pinilla~\cite {acebes2024}.}}{7}{figure.1.5}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces End-to-end automated workflow for a single patient case. Each block constitutes a self-contained processing stage; arrows indicate mandatory sequential dependencies and the principal data passed between stages.}}{8}{figure.2.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Block~1 hybrid workflow: spatial separation of the right and left coronary trees, automated seed placement on each tree, and extraction of centerline geometry with branch packaging.}}{10}{figure.2.2}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Block~2 workflow: orthogonal cross-sectional area extraction on each artery centerline and surface mesh, tabular integration, proximal/distal reference estimation, and \%AS quantification.}}{12}{figure.2.3}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Block~3 workflow: segment aggregation based on the AHA 17-segment model and automated CAD-RADS~2.0 scoring.}}{15}{figure.2.4}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Block~4 user interface layout and interaction flow: from global 3D anatomy and clinical summary to segment-level and branch-level metric validation.}}{18}{figure.2.5}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Block~1 outputs for Normal\_8 in four side-by-side panels. Left pair (ASOCA, then MACS-18): centerline paths with red ostium points and blue branch endpoints. Right pair (ASOCA, then MACS-18): smoothed lumen surfaces with light-red LCA and light-blue RCA.}}{23}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Extracted centerlines on the synthetic validation models. Left: \texttt {synthetic\_1} (healthy, uniform radius). Right: \texttt {synthetic\_2} (diseased, mid-vessel stenosis).}}{24}{figure.3.2}%
